; Mś Pseudo-Paint

; Constants in code
CONSTANT RESET, 00;
CONSTANT SET,  01;
CONSTANT ZERO, 00;
CONSTANT ONE,  01;
CONSTANT LEFT_BIT, 80;
CONSTANT RIGHT_BIT, 01;
CONSTANT X_MAX, 9f; 159
CONSTANT Y_MAX, 77; 119
CONSTANT COLOR_WHITE, 3f;

; Registers aliases
CONSTANT PORT_0, 00;
CONSTANT PORT_1, 01;
CONSTANT PORT_2, 02;
CONSTANT PORT_3, 03;
CONSTANT PORT_4, 04;
CONSTANT PORT_5, 05;
CONSTANT PORT_6, 06;
CONSTANT PORT_7, 07;
CONSTANT PORT_8, 08;

CONSTANT VGA_X, 16;
CONSTANT VGA_Y, 17;
CONSTANT VGA_COLOR, 20;

CONSTANT MOUSE_X, 21;
CONSTANT MOUSE_Y, 22;
CONSTANT MOUSE_Z, 23;
CONSTANT MOUSE_FLAGS, 24;

; CPU registers aliases
NAMEREG s0, CNTR;
NAMEREG s1, M_X;
NAMEREG s2, M_Y;
NAMEREG s3, M_X_S;
NAMEREG s4, M_Y_S;
NAMEREG s5, M_X_O;
NAMEREG s6, M_Y_O;
NAMEREG s7, X_CNTR;
NAMEREG s8, Y_CNTR;
NAMEREG sa, TMP;
NAMEREG sb, CNTR_1;
NAMEREG sc, CNTR_2;
NAMEREG sd, ISR_FLAG;
NAMEREG se, M_F;
NAMEREG sf, COLOR_REG;

; White point on middle screen
LOAD X_CNTR, 50;
LOAD Y_CNTR, 3c;
LOAD COLOR_REG, COLOR_WHITE;

LOAD CNTR_1, RESET;
LOAD CNTR_2, RESET;
LOAD ISR_FLAG, RESET;
LOAD M_F, RESET;

; Wait for reset memory content (16 bit)
CALL WAIT_16BIT;

OUTPUT X_CNTR, VGA_X;
OUTPUT Y_CNTR, VGA_Y;
OUTPUT COLOR_REG, VGA_COLOR;

ENABLE INTERRUPT;

TEST_PS2_MOUSE:

LOAD TMP, FF;
;OUTPUT TMP, PORT_1;
;OUTPUT TMP, PORT_2;
;OUTPUT TMP, PORT_3; DEBUG PORT
;OUTPUT TMP, PORT_4;
;OUTPUT TMP, PORT_5;
;OUTPUT TMP, PORT_6;
;OUTPUT TMP, PORT_7;
;OUTPUT TMP, PORT_8;

COMPARE ISR_FLAG, SET;
JUMP NZ, JUMP_1;
LOAD ISR_FLAG, RESET;
INPUT M_X, MOUSE_X;
INPUT M_Y, MOUSE_Y;
INPUT M_F, MOUSE_FLAGS;

COMPARE M_F, 01;
JUMP NZ, CHECK;
SUB COLOR_REG, ONE;
;JUMP END_ISR;

CHECK:

LOAD TMP, M_F;
AND TMP, 10;
AND M_X, 01;
OR M_X, TMP;

LOAD TMP, M_F;
AND TMP, 20;
AND M_Y, 01;
OR M_Y, TMP;

OUTPUT M_X, PORT_3;

TEST M_X, 01;
JUMP NZ, NEXT_1;
TEST M_X, 10;
JUMP NZ, NEXT_2;
TEST M_Y, 01;
JUMP NZ, NEXT_3;
TEST M_Y, 20;
JUMP NZ, NEXT_4;
JUMP JUMP_1;

NEXT_1:
ADD X_CNTR, SET;
ADD Y_CNTR, ZERO;
JUMP END_ISR;

NEXT_2:
SUB X_CNTR, SET;
SUB Y_CNTR, ZERO;
JUMP END_ISR;

NEXT_3:
ADD X_CNTR, ZERO;
ADD Y_CNTR, SET;
JUMP END_ISR;

NEXT_4:
SUB X_CNTR, ZERO;
SUB Y_CNTR, SET;

END_ISR:
OUTPUT X_CNTR, VGA_X;
OUTPUT Y_CNTR, VGA_Y;
OUTPUT COLOR_REG, VGA_COLOR;

JUMP_1:
LOAD M_X, ZERO;
LOAD M_Y, ZERO;
LOAD M_F, ZERO;
LOAD M_X_S, ZERO;
LOAD M_Y_S, ZERO;

JUMP TEST_PS2_MOUSE;

WAIT_8BIT:
LOAD CNTR_1, ZERO;
WAIT_8BIT_1:
ADDCY CNTR_1, ONE;
JUMP NC, WAIT_8BIT_1;
RETURN;

WAIT_16BIT:
LOAD CNTR_1, ZERO;
LOAD CNTR_2, ZERO;
WAIT_16BIT_1:
ADD CNTR_1, ONE;
ADDCY CNTR_2, ZERO;
COMPARE CNTR_2, FF;
JUMP NZ, WAIT_16BIT_1;
RETURN;

ISR:
LOAD ISR_FLAG, SET;
RETURNI ENABLE;

ADDRESS 3FF;
JUMP ISR;

