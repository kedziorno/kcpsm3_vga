; Mś Pseudo-Paint

CONSTANT ZERO, 00;
CONSTANT ONE,  01;
CONSTANT LEFT_BIT, 80;
CONSTANT RIGHT_BIT, 01;
CONSTANT X_MAX, 9f; 159
CONSTANT Y_MAX, 77; 119

CONSTANT X_ROW, 16;
CONSTANT Y_COL, 17;
CONSTANT COLOR, 20;
CONSTANT COLOR_WHITE, 3f;

CONSTANT MOUSE_X, 21;
CONSTANT MOUSE_Y, 22;
CONSTANT MOUSE_FLAGS, 23;
CONSTANT MOUSE_X_SGN, 24;
CONSTANT MOUSE_Y_SGN, 25;
CONSTANT MOUSE_X_OFW, 26;
CONSTANT MOUSE_Y_OFW, 27;

CONSTANT PORT_1, 01;
CONSTANT PORT_2, 02;
CONSTANT PORT_3, 03;
CONSTANT PORT_4, 04;
CONSTANT PORT_5, 05;
CONSTANT PORT_6, 06;
CONSTANT PORT_7, 07;
CONSTANT PORT_8, 08;

NAMEREG s1, M_X;
NAMEREG s2, M_Y;
NAMEREG s3, M_X_S;
NAMEREG s4, M_Y_S;
NAMEREG s5, M_X_O;
NAMEREG s6, M_Y_O;

ENABLE INTERRUPT;
TEST_PS2_MOUSE:
JUMP TEST_PS2_MOUSE; -- only ISR at end of file, leave rest code

ISR:
  LOAD s0, COLOR_WHITE;
  OUTPUT s0, COLOR;
  INPUT M_X, MOUSE_X;
  ;SR0 M_X;
  INPUT M_Y, MOUSE_Y;
  ;SR0 M_Y;
  INPUT M_X_S, MOUSE_X_SGN;
  INPUT M_Y_S, MOUSE_Y_SGN;
  INPUT M_X_O, MOUSE_X_OFW;
  INPUT M_Y_O, MOUSE_Y_OFW;

	X:
	TEST M_X_S, ONE;
	JUMP NZ, X_POS;
	
	X_NEG:
		TEST M_X_S, ONE;
		JUMP NZ, X_NO_OFW_1;
		LOAD s7, ZERO;
		JUMP X_ADD_1;
	X_NO_OFW_1:
		LOAD s7, M_X;
		XOR s7, 80;
	X_ADD_1:
		ADD M_X, s7;
		TEST M_X, 80;
		;JUMP NZ, X_NO_1;
		OUTPUT M_X, X_ROW;
		JUMP Y;
	X_NO_1:
		LOAD sf, ZERO;
		OUTPUT sf, X_ROW;
		JUMP Y;
		
	X_POS:
		TEST M_X_S, ONE;
		JUMP NZ, X_NO_OFW_2;
		LOAD s7, ZERO;
		JUMP X_ADD_2;
	X_NO_OFW_2:
		LOAD s7, M_X;
		XOR s7, 80;
	X_ADD_2:
		ADD M_X, s7;
		TEST M_X, 80;
		;JUMP NZ, X_NO_2;
		OUTPUT M_X, X_ROW;
		JUMP END_ISR;
	X_NO_2:
		LOAD sf, ZERO;
		OUTPUT sf, X_ROW;
		JUMP END_ISR;
	
	Y:
	TEST M_Y_S, ONE;
	JUMP NZ, Y_POS;
	
	Y_NEG:
		TEST M_Y_S, ONE;
		JUMP NZ, Y_NO_OFW_1;
		LOAD s7, ZERO;
		JUMP Y_ADD_1;
	Y_NO_OFW_1:
		LOAD s7, M_Y;
		XOR s7, 80;
	Y_ADD_1:
		ADD M_Y, s7;
		TEST M_Y, 80;
		;JUMP NZ, Y_NO_1;
		OUTPUT M_Y, Y_COL;
		JUMP END_ISR;
	Y_NO_1:
		LOAD sf, ZERO;
		OUTPUT sf, Y_COL;
		JUMP END_ISR;
		
	Y_POS:
		TEST M_Y_S, ONE;
		JUMP NZ, Y_NO_OFW_2;
		LOAD s7, ZERO;
		JUMP Y_ADD_2;
	Y_NO_OFW_2:
		LOAD s7, M_Y;
		XOR s7, 80;
	Y_ADD_2:
		ADD M_Y, s7;
		TEST M_Y, 80;
		;JUMP NZ, Y_NO_2;
		OUTPUT M_Y, Y_COL;
		JUMP END_ISR;
	Y_NO_2:
		LOAD sf, ZERO;
		OUTPUT sf, Y_COL;
		JUMP END_ISR;
	
  END_ISR:
RETURNI ENABLE;

ADDRESS 3FF;
JUMP ISR;
